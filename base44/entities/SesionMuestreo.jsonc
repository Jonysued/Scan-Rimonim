{
  "name": "SesionMuestreo",
  "type": "object",
  "properties": {
    "bloque_id": {
      "type": "string"
    },
    "muestreador_name": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "procesando",
        "listo",
        "error"
      ],
      "default": "borrador"
    },
    "photo_count": {
      "type": "number",
      "default": 0
    },
    "fruit_count": {
      "type": "number",
      "default": 0
    },
    "avg_diameter_mm": {
      "type": "number"
    },
    "red_pct": {
      "type": "number"
    },
    "cracking_pct": {
      "type": "number"
    },
    "sunburn_pct": {
      "type": "number"
    },
    "russet_pct": {
      "type": "number"
    },
    "reference_type": {
      "type": "string",
      "enum": ["tarjeta", "pelota", "ninguna"]
    },
    "measured_count": {
      "type": "number",
      "description": "Frutos con calibre medido contra referencia"
    }
  },
  "required": [
    "bloque_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "muestreador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}