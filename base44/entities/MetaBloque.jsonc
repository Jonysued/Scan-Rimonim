{
  "name": "MetaBloque",
  "type": "object",
  "properties": {
    "bloque_id": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "target_diameter_mm": {
      "type": "number"
    },
    "target_red_pct": {
      "type": "number"
    },
    "max_cracking_pct": {
      "type": "number"
    },
    "max_sunburn_pct": {
      "type": "number"
    },
    "max_russet_pct": {
      "type": "number"
    }
  },
  "required": [
    "bloque_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}